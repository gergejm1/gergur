<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gergur</RootNamespace>
    <AssemblyName>Gergur</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- MSB3277: the WebView2 package also ships its WPF assembly, which references
         an older WindowsBase; we only use the WinForms one, so the conflict is moot. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <ApplicationIcon>Assets\gergur.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <!-- Pairing QR for the phone drop. MIT, no dependencies of its own. A hand-rolled
         encoder is a lot of spec to get subtly wrong, and a QR that will not scan is
         worse than no QR. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The .test.js beside adblock.js is run by .claude/checks.sh under node and has
         no business in a shipped browser, so it is not copied out. -->
    <Content Include="Assets\**" Exclude="Assets\**\*.test.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gergur.Tests" />
  </ItemGroup>

</Project>
